# Configuracion del Servidor
PORT=3050
HOST=0.0.0.0
API_URL=/api/v1
NODE_ENV=production
JWT_SECRET=tu_jwt_secret_seguro_2026

# Base de Datos MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fintech_hedging_db

# Base de Datos Supabase PostgreSQL
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key

# Broker Predeterminado (WEBULL, ALPACA o IBKR)
DEFAULT_BROKER=WEBULL

# Alpaca Markets
ALPACA_API_KEY_ID=tu_alpaca_key_id
ALPACA_API_SECRET_KEY=tu_alpaca_secret_key
