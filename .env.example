# ==========================================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR EXPRESS
# ==========================================================
# localhost => escucha en dual-stack (IPv4 + IPv6). Usa 0.0.0.0 para forzar IPv4.
HOST=localhost
PORT=3050
API_URL=/api/v1
NODE_ENV=development
JWT_SECRET=tu_jwt_secret_token_aqui

# DNS alternativo SOLO si el resolver del sistema no resuelve SRV de MongoDB Atlas.
# Ejemplo: DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=

# Tolerancia del guardrail F0: prima de mercado / prima teórica Black-Scholes.
F0_MAX_PREMIUM_RATIO=6

# ==========================================================
# CONEXIÓN NoSQL: MONGODB ATLAS
# ==========================================================
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fintech_hedging_db

# ==========================================================
# CONEXIÓN SQL / HÍBRIDO: SUPABASE (POSTGRESQL + JSONB)
# ==========================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# ==========================================================
# BROKERS BURSÁTILES: CONFIGURACIÓN MULTI-BROKER
# ==========================================================
DEFAULT_BROKER=WEBULL

# Alpaca Markets (Paper Trading)
ALPACA_API_KEY_ID=tu_alpaca_api_key
ALPACA_API_SECRET_KEY=tu_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# Webull OpenAPI (Open Platform & Paper Trading)
WEBULL_APP_KEY=tu_webull_app_key_aqui
WEBULL_APP_SECRET=tu_webull_app_secret_aqui
WEBULL_ACCOUNT_ID=tu_webull_paper_account_id
WEBULL_BASE_URL=https://api.sandbox.webull.com

